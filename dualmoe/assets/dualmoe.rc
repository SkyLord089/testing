// Windows resources for DualMoE.exe: application icon + version metadata.
// Resource id 1 (IDI_DUALMOE / ICON_MAIN) is what main_desktop.cpp loads for the
// title bar and taskbar button.
#include <winver.h>

#define IDI_DUALMOE 1

IDI_DUALMOE ICON "dualmoe.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,4,1,0
 PRODUCTVERSION 0,4,1,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DualMoE"
            VALUE "FileDescription",  "DualMoE - local MoE studio (VRAM <-> RAM)"
            VALUE "FileVersion",      "0.4.1.0"
            VALUE "InternalName",     "DualMoE"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "DualMoE.exe"
            VALUE "ProductName",      "DualMoE"
            VALUE "ProductVersion",   "0.4.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
