+size_t llama_moe_cache::prewarm(llama_moe_cache_fetch_cb_t fetch_cb, void * user_data) {
+    if (!fetch_cb) {
+        return 0;
+    }
+    size_t total_uploaded = 0;
+    for (auto & g : pimpl->groups) {
+        if (g.n_slots <= 0 || g.layers.empty() || g.banks.empty()) {
+            continue;
+        }
+        size_t max_eb = 0;
+        for (const ggml_tensor * w : g.ref) {
+            max_eb = std::max<size_t>(max_eb, w->nb[2]);
+        }
+        if (max_eb == 0) {
+            continue;
+        }
+        std::vector<uint8_t> staging(max_eb);
+        const int32_t n_exp = g.lru.n_expert;
+        const size_t  n_lay = g.layers.size();
+
+        // Iterate layer-by-layer (disk sequential order) while mapping each (li, exp) to balanced slot s
+        for (size_t li = 0; li < n_lay; ++li) {
+            const int32_t il   = g.layers[li];
+            const auto &  exps = pimpl->layers[il].experts;
+            for (int32_t exp = 0; exp < n_exp; ++exp) {
+                const size_t slot_idx = (size_t) exp * n_lay + li;
+                if (slot_idx >= (size_t) g.n_slots) {
+                    break;
+                }
+                const int32_t s = (int32_t) slot_idx;
+                if (g.lru.slot_map[il][exp] < g.n_slots) {
+                    continue;
+                }
+                bool ok = true;
+                for (size_t ip = 0; ip < exps.size() && ip < g.banks.size(); ++ip) {
+                    const ggml_tensor * w = exps[ip];
+                    const size_t eb = w->nb[2];
+                    if (!fetch_cb(il, (int32_t) ip, exp, w->name, staging.data(), eb, user_data)) {
+                        ok = false;
+                        break;
+                    }
+                    ggml_backend_tensor_set(g.banks[ip], staging.data(), (size_t) s * eb, eb);
+                    total_uploaded += eb;
+                }
+                if (!ok) {
+                    break;
+                }
+                if (g.lru.key_of[s] >= 0) {
+                    const int32_t old_il  = g.lru.key_layer(g.lru.key_of[s]);
+                    const int32_t old_exp = g.lru.key_expert(g.lru.key_of[s]);
+                    g.lru.slot_map[old_il][old_exp] = g.lru.empty;
+                } else {
+                    g.lru.n_filled++;
+                }
+                const int32_t key = g.lru.make_key(il, exp);
+                g.lru.key_of[s]         = key;
+                g.lru.slot_map[il][exp] = s;
+                g.lru.crf[key]          = 1.0f;
+                g.lru.last_use[key]     = 0;
+                g.lru.move(s, g.lru.class_of(key));
+            }
+        }
+    }
+    return total_uploaded;
+}
