+
+void llama_set_moe_cache_host_cb(struct llama_context * ctx, llama_moe_cache_host_cb_t cb, void * user_data) {
+    if (ctx) {
+        ctx->set_moe_cache_host_cb(cb, user_data);
+    }
+}
+
+size_t llama_context::moe_cache_prewarm(llama_moe_cache_fetch_cb_t fetch_cb, void * user_data) {
+    return moe_cache ? moe_cache->prewarm(fetch_cb, user_data) : 0;
+}
+
+void llama_context::set_moe_cache_swap_cbs(llama_moe_cache_evict_cb_t evict_cb, llama_moe_cache_promoted_cb_t promoted_cb, float swap_hysteresis, void * user_data) {
+    if (moe_cache) {
+        moe_cache->set_swap_cbs(evict_cb, promoted_cb, swap_hysteresis, user_data);
+    }
+}
+
+void llama_context::set_moe_cache_cpu_share(float cpu_share) {
+    if (moe_cache) {
+        moe_cache->set_cpu_share(cpu_share);
+    }
+}
+
+bool llama_context::moe_cache_rescue_expert(int32_t il, int32_t expert_id, llama_moe_cache_evict_cb_t dst_cb, void * user_data) {
+    return moe_cache ? moe_cache->rescue_expert(il, expert_id, dst_cb, user_data) : false;
+}
+
+size_t llama_moe_cache_prewarm(struct llama_context * ctx, llama_moe_cache_fetch_cb_t fetch_cb, void * user_data) {
+    return ctx ? ctx->moe_cache_prewarm(fetch_cb, user_data) : 0;
+}
+
+void llama_context::set_moe_cache_pinned(const std::vector<std::pair<int32_t, int32_t>> * experts) {
+    if (moe_cache) {
+        moe_cache->set_pinned(experts);
+    }
+}
+
+void llama_set_moe_cache_pinned(struct llama_context * ctx, const int32_t * layer_ids, const int32_t * expert_ids, size_t n) {
+    if (!ctx) {
+        return;
+    }
+    if (layer_ids == nullptr || expert_ids == nullptr || n == 0) {
+        ctx->set_moe_cache_pinned(nullptr);
+        return;
+    }
+    std::vector<std::pair<int32_t, int32_t>> experts;
+    experts.reserve(n);
+    for (size_t i = 0; i < n; ++i) {
+        experts.emplace_back(layer_ids[i], expert_ids[i]);
+    }
+    std::sort(experts.begin(), experts.end());
+    experts.erase(std::unique(experts.begin(), experts.end()), experts.end());
+    ctx->set_moe_cache_pinned(&experts);
+}
+
+void llama_set_moe_cache_swap_cbs(struct llama_context * ctx, llama_moe_cache_evict_cb_t evict_cb, llama_moe_cache_promoted_cb_t promoted_cb, float swap_hysteresis, void * user_data) {
+    if (ctx) {
+        ctx->set_moe_cache_swap_cbs(evict_cb, promoted_cb, swap_hysteresis, user_data);
+    }
+}
+
+void llama_set_moe_cache_cpu_share(struct llama_context * ctx, float cpu_share) {
+    if (ctx) {
+        ctx->set_moe_cache_cpu_share(cpu_share);
+    }
+}
+
+bool llama_moe_cache_rescue_expert(struct llama_context * ctx, int32_t il, int32_t expert_id, llama_moe_cache_evict_cb_t dst_cb, void * user_data) {
+    return ctx ? ctx->moe_cache_rescue_expert(il, expert_id, dst_cb, user_data) : false;
+}
