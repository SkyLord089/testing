+void llama_moe_cache::set_pinned(const std::vector<std::pair<int32_t, int32_t>> * experts) {
+    size_t n_pinned = 0;
+    for (auto & g : pimpl->groups) {
+        std::fill(g.lru.pinned.begin(), g.lru.pinned.end(), 0);
+        if (experts == nullptr) {
+            continue;
+        }
+        for (const auto & e : *experts) {
+            const int32_t il = e.first;
+            const int32_t ex = e.second;
+            if (il < 0 || (size_t) il >= pimpl->layers.size() || ex < 0 || ex >= g.lru.n_expert) {
+                continue;
+            }
+            if (g.lru.slot_map[il] == nullptr) {
+                continue; // the layer is not cached in this group
+            }
+            uint8_t & flag = g.lru.pinned[(size_t) g.lru.make_key(il, ex)];
+            if (!flag) {
+                flag = 1;
+                n_pinned++;
+            }
+        }
+        // never pin more experts than there are slots: keep the ClassLRU usable
+        if (n_pinned >= (size_t) g.lru.n_slots) {
+            std::fill(g.lru.pinned.begin(), g.lru.pinned.end(), 0);
+            n_pinned = 0;
+        }
+    }
+    pimpl->n_pinned = n_pinned;
+}
+
+void llama_moe_cache::set_swap_cbs(llama_moe_cache_evict_cb_t evict_cb, llama_moe_cache_promoted_cb_t promoted_cb, float swap_hysteresis, void * user_data) {
+    pimpl->evict_cb        = evict_cb;
+    pimpl->promoted_cb     = promoted_cb;
+    pimpl->swap_hysteresis = std::max(0.0f, swap_hysteresis);
+    pimpl->swap_cb_ud      = user_data;
+}
+
+void llama_moe_cache::set_cpu_share(float cpu_share) {
+    const float clamped = std::max(0.0f, std::min(1.0f, cpu_share));
+    pimpl->cpu_share   = clamped;
+    pimpl->cpu_share_q = (uint32_t) std::round(clamped * 65536.0f);
+}
+
+bool llama_moe_cache::rescue_expert(int32_t il, int32_t expert_id, llama_moe_cache_evict_cb_t dst_cb, void * user_data) {
+    if (!dst_cb || il < 0 || (size_t) il >= pimpl->layers.size()) {
+        return false;
+    }
+    const auto & l = pimpl->layers[il];
+    if (l.ig < 0 || (size_t) l.ig >= pimpl->groups.size()) {
+        return false;
+    }
+    const auto & g = pimpl->groups[l.ig];
+    if (expert_id < 0 || expert_id >= g.lru.n_expert || l.slot_map == nullptr) {
+        return false;
+    }
+    const int32_t s = g.lru.slot_map[il][expert_id];
+    if (s < 0 || s >= g.n_slots) {
+        return false;
+    }
+    bool any_rescued = false;
+    for (size_t ip = 0; ip < l.experts.size() && ip < g.banks.size(); ++ip) {
+        const ggml_tensor * w = l.experts[ip];
+        const size_t eb = w->nb[2];
+        void * dst = dst_cb(il, (int32_t) ip, expert_id, w->name, eb, user_data);
+        if (dst != nullptr) {
+            ggml_backend_tensor_get(g.banks[ip], dst, (size_t) s * eb, eb);
+            any_rescued = true;
+        }
+    }
+    return any_rescued;
+}
