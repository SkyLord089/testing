+
+// ---- DualMoE parallel-seam profile ------------------------------------------------------------
+// The splits of the last graph are recorded by ggml_backend_sched (see ggml-backend.cpp). A layer is
+// "dual" when its GPU split and its CPU split overlapped in time, i.e. both engines worked on the
+// same token at once; it is "serial" when the CPU split ran in a gap after the GPU one.
+void ggml_backend_sched_parallel_probe(bool on);
+int  ggml_backend_sched_parallel_probe_count(void);
+bool ggml_backend_sched_parallel_probe_get(int i, int32_t * backend, int32_t * il, double * ms, int64_t * t0, int64_t * t1);
+
+static std::vector<llama_parallel_split> g_par_out;
+static bool                              g_par_armed = true;
+static int64_t                           g_par_origin = 0;
+
+void llama_reset_parallel_profile(struct llama_context * ctx) {
+    (void) ctx;
+    g_par_out.clear();
+    ggml_backend_sched_parallel_probe(g_par_armed);
+}
+
+bool llama_moe_cache_parallel_profile(struct llama_context * ctx, struct llama_parallel_profile * out) {
+    if (ctx == nullptr || out == nullptr) {
+        return false;
+    }
+    const int n = ggml_backend_sched_parallel_probe_count();
+    g_par_out.clear();
+    g_par_out.reserve((size_t) n);
+    for (int i = 0; i < n; ++i) {
+        int32_t backend = 0, il = -1;
+        double  ms = 0.0;
+        int64_t t0 = 0, t1 = 0;
+        if (!ggml_backend_sched_parallel_probe_get(i, &backend, &il, &ms, &t0, &t1)) {
+            continue;
+        }
+        if (g_par_out.empty()) {
+            g_par_origin = t0;
+        }
+        g_par_out.push_back(llama_parallel_split{ backend, il, ms, t0 - g_par_origin, t1 - g_par_origin });
+    }
+
+    std::memset(out, 0, sizeof(*out));
+    out->splits   = g_par_out.empty() ? nullptr : g_par_out.data();
+    out->n_splits = (int32_t) g_par_out.size();
+
+    // group by layer and measure the overlap of the GPU and the CPU split of that layer
+    for (int32_t il = 0; il < 4096; ++il) {
+        const llama_parallel_split * gpu = nullptr;
+        const llama_parallel_split * cpu = nullptr;
+        for (const auto & sp : g_par_out) {
+            if (sp.il != il) {
+                continue;
+            }
+            if (sp.backend == 0) { if (cpu == nullptr || sp.ms > cpu->ms) cpu = &sp; }
+            else                 { if (gpu == nullptr || sp.ms > gpu->ms) gpu = &sp; }
+        }
+        if (gpu == nullptr && cpu == nullptr) {
+            continue;
+        }
+        if (gpu != nullptr) { out->n_gpu++; out->gpu_ms += gpu->ms; }
+        if (cpu != nullptr) { out->n_cpu++; out->cpu_ms += cpu->ms; }
+        if (gpu != nullptr && cpu != nullptr) {
+            const int64_t lo = std::max(gpu->t0_ns, cpu->t0_ns);
+            const int64_t hi = std::min(gpu->t1_ns, cpu->t1_ns);
+            if (hi > lo) {
+                out->overlap_ms += (double) (hi - lo) / 1000.0;
+                out->n_dual++;
+            } else {
+                out->n_serial++;
+            }
+        } else if (cpu != nullptr) {
+            out->n_serial++;
+        }
+        if (il > 0 && gpu == nullptr && cpu == nullptr && out->n_splits > 0 && il > 512) {
+            break;
+        }
+    }
+    return out->n_splits > 0;
+}
+
+bool llama_moe_cache_rescue_expert(struct llama_context * ctx, int32_t il, int32_t expert_id, llama_moe_cache_evict_cb_t dst_cb, void * user_data) {
+    return ctx ? ctx->moe_cache_rescue_expert(il, expert_id, dst_cb, user_data) : false;
+}
