+// DualMoE parallel-seam probe: records when each split of the last graph started and finished, so the
+// engine can tell whether the CPU split of a layer really overlapped the GPU split of the same layer
+// (true GPU || CPU on one token) or ran afterwards in a gap (serialised, i.e. no parallelism at all).
+struct ggml_parallel_split_rec {
+    int32_t backend;
+    int32_t il;
+    double  ms;
+    int64_t t0;
+    int64_t t1;
+};
+
+#define GGML_SCHED_PAR_MAX_SPLITS 512
+static ggml_parallel_split_rec g_par_splits[GGML_SCHED_PAR_MAX_SPLITS];
+static int                     g_par_n_splits = 0;
+static bool                    g_par_on       = false;
+
+void ggml_backend_sched_parallel_probe(bool on) {
+    g_par_on       = on;
+    g_par_n_splits = 0;
+}
+
+int ggml_backend_sched_parallel_probe_count(void) {
+    return g_par_n_splits;
+}
+
+bool ggml_backend_sched_parallel_probe_get(int i, int32_t * backend, int32_t * il, double * ms, int64_t * t0, int64_t * t1) {
+    if (i < 0 || i >= g_par_n_splits) {
+        return false;
+    }
+    *backend = g_par_splits[i].backend;
+    *il      = g_par_splits[i].il;
+    *ms      = g_par_splits[i].ms;
+    *t0      = g_par_splits[i].t0;
+    *t1      = g_par_splits[i].t1;
+    return true;
+}
+
+// Layer of a split: the split boundary is the MoE selector, so the layer index is taken from the first
+// named tensor of the split graph ("ffn_moe_topk-<il>", "ffn_moe_slots-<il>", "blk.<il>.").
+static int32_t ggml_backend_sched_split_layer(const struct ggml_cgraph * g) {
+    for (int i = 0; i < g->n_nodes; ++i) {
+        const char * name = g->nodes[i]->name;
+        if (name[0] == '\0') {
+            continue;
+        }
+        const char * dash = strrchr(name, '-');
+        if (dash != nullptr && dash[1] >= '0' && dash[1] <= '9') {
+            return atoi(dash + 1);
+        }
+        if (strncmp(name, "blk.", 4) == 0) {
+            return atoi(name + 4);
+        }
+    }
+    return -1;
+}
+
+static void ggml_backend_sched_parallel_record(int backend_id, const struct ggml_cgraph * g, int64_t t0, int64_t t1) {
+    if (g_par_n_splits >= GGML_SCHED_PAR_MAX_SPLITS) {
+        return;
+    }
+    ggml_parallel_split_rec & r = g_par_splits[g_par_n_splits++];
+    r.backend = backend_id;
+    r.il      = ggml_backend_sched_split_layer(g);
+    r.ms      = (double) (t1 - t0) / 1e6;
+    r.t0      = t0;
+    r.t1      = t1;
+}
+
+// see the definition above (exported for the DualMoE parallel-seam profile)
+void ggml_backend_sched_parallel_probe(bool on);
+int  ggml_backend_sched_parallel_probe_count(void);
+bool ggml_backend_sched_parallel_probe_get(int i, int32_t * backend, int32_t * il, double * ms, int64_t * t0, int64_t * t1);
+
+
